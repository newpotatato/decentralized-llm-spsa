# Paper figure kept in paper/figs/ — override the global *.png exclusion
!paper/figs/*.png
buffered_outputs/
smoke_outputs/
.venv/

# Experiment artifacts.  Each run directory is tens of megabytes and is
# regenerated by src.run_paper_experiments; the manifest records the
# commit every artifact came from.
paper_experiment_outputs*/

# Paper figures for REAL_BENCHMARK_REPORT.md — override the global *.png exclusion
!figures/*.png
# Figure caches, rebuilt by src.report_figures
figures/data/*.pkl

# Real-benchmark runs the report does not use (superseded or exploratory)
real_benchmark_outputs/atc/
real_benchmark_outputs/llmrouterbench/
real_benchmark_outputs/llmrouterbench_rerun/
policy_outputs*/
policy_three*/
policy_lownoise*/

# Local run queues and their markers
run_queue_*.sh
run_atc.sh
run_policy_all.sh
run_report_chain.sh
*.done

